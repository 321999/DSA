class N:
	def __init__(s,d):
		s.d=d
		s.p=None
		s.n=None

class S:
	def __init__(s):
		s.head=None
	
	def push(s,d):
		n=N(d)
		n.p=s.head
		if s.head is not None:
			s.head.n=n
		s.head=n
	
	# to know where i am 
	def seek(s):
		return s.head.d
	
	def pop(s):
		s.head=s.head.p
		
s=S()

s.push(1)
s.push(2)
s.push(3)
print(s.seek())
s.pop()

print("after pop ",s.seek())
s.push(3)
print(s.seek())
s.pop()

print("after pop ",s.seek())
